# Environment files
/.env

# Secrets — appsettings carries the database connection string and the JWT signing
# key. Commit appsettings.Example.json instead and supply real values through
# environment variables (or `dotnet user-secrets` locally).
appsettings.json
appsettings.*.json
!appsettings.Example.json

# .NET build output
[Bb]in/
[Oo]bj/

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
